          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda podróż zaczyna się od jednego kroku. Gratulacje - jesteś w drodze!"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda jornada começa com um único passo. Parabéns — você está a caminho!"
