      }
    },
    "Exercising the mind is as important as exercise for the body. Keep up the great work!" : {
      "comment" : "A congratulatory message for the badge with the same name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Trainieren des Geistes ist für den Körper genauso wichtig wie Bewegung. Mach weiter so!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejercitar la mente es tan importante como el ejercicio para el cuerpo. ¡Sigue con el gran trabajo!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
