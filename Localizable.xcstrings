    "Solve a total of 75 puzzles. A minimum of 20 puzzles must be rated at level ten." : {
      "comment" : "Badge title for puzzles 75.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löse insgesamt 75 Rätsel. Mindestens 20 Rätsel müssen auf Stufe zehn bewertet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuelve un total de 75 acertijos. Un mínimo de 20 rompecabezas debe ser calificado en el nivel diez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résolvez un total de 75 énigmes. Un minimum de 20 énigmes doivent être notées au niveau dix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुल 75 पहेलियों को हल करें। न्यूनतम 20 पहेलियों को स्तर दस पर रेट किया जाना चाहिए।"
