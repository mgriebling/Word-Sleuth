          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los in totaal 75 puzzels op. Minimaal 20 puzzels moeten worden beoordeeld op niveau tien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozwiąż w sumie 75 zagadek. Minimum 20 zagadek musi być ocenionych na poziomie dziesiątym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
