    "Unravel seven puzzles to earn this badge. A minimum of three need to be at level seven or higher." : {
      "comment" : "Badge description for \"Puzzle 7\" badge.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entwirre sieben Rätsel, um dieses Abzeichen zu verdienen. Mindestens drei müssen auf Stufe sieben oder höher sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desentraña siete rompecabezas para ganar esta insignia. Un mínimo de tres debe estar en el nivel siete o superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démêlez sept énigmes pour gagner ce badge. Un minimum de trois doivent être au niveau sept ou plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बैज को अर्जित करने के लिए सात पहेली को सुलझाएं। न्यूनतम तीन स्तर सात या उससे अधिक होने की आवश्यकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svela sette puzzle per guadagnare questo distintivo. Un minimo di tre devono essere al livello sette o superiore."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontrafel zeven puzzels om deze badge te verdienen. Minimaal drie moeten op niveau zeven of hoger zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozwiń siedem zagadek, aby zdobyć tę odznakę. Minimum trzy muszą być na poziomie siódmym lub wyższym."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desvenda sete quebra-cabeças para ganhar este distintivo. Um mínimo de três precisa estar no nível sete ou superior."
