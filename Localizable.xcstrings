    "Every journey begins with a single step. Congratulations — you’re on your way!" : {
      "comment" : "A congratulatory message for the first badge.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Reise beginnt mit einem einzigen Schritt. Herzlichen Glückwunsch - Sie sind auf dem Weg!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada viaje comienza con un solo paso. Felicidades, ¡estás en camino!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque voyage commence par une seule étape. Félicitations - vous êtes en route !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर यात्रा एक कदम से शुरू होती है। बधाई हो - आप अपने रास्ते पर हैं!"
          }
        },
        "it" : {
          "stringUnit" : {
