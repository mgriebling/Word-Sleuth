    "Successfully complete 100 puzzles and have all nine earlier badges. At least 30 puzzles must be at level ten." : {
      "comment" : "The congratulatory message for the badge with the title \"Grand Master\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe 100 Rätsel erfolgreich ab und habe alle neun früheren Abzeichen. Mindestens 30 Rätsel müssen auf Stufe zehn sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa con éxito 100 rompecabezas y ten las nueve insignias anteriores. Al menos 30 rompecabezas deben estar en el nivel diez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complétez avec succès 100 énigmes et ayez les neuf badges précédents. Au moins 30 énigmes doivent être au niveau dix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "100 पहेलियों को सफलतापूर्वक पूरा करें और पहले के सभी नौ बैज रखें। कम से कम 30 पहेलियां स्तर दस पर होनी चाहिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completa con successo 100 puzzle e hai tutti e nove i badge precedenti. Almeno 30 puzzle devono essere al livello dieci."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltooi met succes 100 puzzels en heb alle negen eerdere badges. Ten minste 30 puzzels moeten op niveau tien zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
