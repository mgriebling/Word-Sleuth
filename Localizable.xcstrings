        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मन को व्यायाम करना उतना ही महत्वपूर्ण है जितना कि शरीर के लिए व्यायाम। अच्छा काम करते रहो!"
